{
  "name": "@papercusp/testing-shell",
  "version": "0.0.1",
  "private": true,
  "description": "Shared testing-domains registry + UI shell. Consumed by /admin/testing (operator-vite) and the harness Tests tab (operator). Registry is pure data; the panel/shell take an injected dataSource so the same component drives both the admin and harness API surfaces.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry": {
      "types": "./src/registry.ts",
      "import": "./src/registry.ts",
      "default": "./src/registry.ts"
    },
    "./data-source": {
      "types": "./src/data-source.ts",
      "import": "./src/data-source.ts",
      "default": "./src/data-source.ts"
    },
    "./glob": {
      "types": "./src/glob.ts",
      "import": "./src/glob.ts",
      "default": "./src/glob.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./web/chaos-runner": {
      "default": "./src/web/chaos-runner.mjs"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "nuqs": ">=2",
    "hono": ">=4",
    "playwright": "*",
    "@browserbasehq/stagehand": "*"
  },
  "peerDependenciesMeta": {
    "hono": { "optional": true },
    "playwright": { "optional": true },
    "@browserbasehq/stagehand": { "optional": true }
  }
}
